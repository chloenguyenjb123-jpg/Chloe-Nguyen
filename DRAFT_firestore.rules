rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // --- Validation Blueprints (Static Checks Only - Safe for Create & Update) ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'monthlyBudget', 'budgetAlertThreshold', 'timezone', 'currency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'monthlyBudget', 'budgetAlertThreshold', 'timezone', 'currency', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000000
        && data.budgetAlertThreshold is number && data.budgetAlertThreshold >= 10 && data.budgetAlertThreshold <= 100
        && data.timezone == 'Asia/Ho_Chi_Minh'
        && data.currency == 'VND'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'description', 'category', 'priority', 'startDate', 'deadline', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'description', 'category', 'priority', 'startDate', 'deadline', 'status', 'notes', 'carriedOverFrom', 'isDemo', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && isDateStr(data.startDate)
        && isDateStr(data.deadline)
        && data.status in ['todo', 'in_progress', 'completed', 'on_hold']
        && data.notes is string && data.notes.size() <= 2000
        && (!('carriedOverFrom' in data) || (data.carriedOverFrom is string && data.carriedOverFrom.size() <= 10 && (data.carriedOverFrom == '' || isDateStr(data.carriedOverFrom))))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'date', 'category', 'paymentMethod', 'description', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'amount', 'date', 'category', 'paymentMethod', 'description', 'note', 'isDemo', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000000
        && isDateStr(data.date)
        && data.category in ['food', 'transportation', 'shopping', 'education', 'bills', 'entertainment', 'health', 'salary', 'other']
        && data.paymentMethod in ['cash', 'bank_transfer', 'e_wallet']
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.note is string && data.note.size() <= 1000
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'content', 'category', 'tags', 'pinned', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'content', 'category', 'tags', 'pinned', 'linkedTaskId', 'isDemo', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 20000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.tags is list && data.tags.size() <= 10
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 32))
        && data.pinned is bool
        && (!('linkedTaskId' in data) || (data.linkedTaskId is string && data.linkedTaskId.size() <= 128 && (data.linkedTaskId == '' || isValidId(data.linkedTaskId))))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExchangeRate(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'baseCurrency', 'rates', 'source', 'fetchedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'baseCurrency', 'rates', 'previousRates', 'source', 'fetchedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isDateStr(data.date)
        && data.baseCurrency == 'VND'
        && data.rates is map && data.rates.size() >= 1 && data.rates.size() <= 20
        && (!('previousRates' in data) || (data.previousRates is map && data.previousRates.size() <= 20))
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 200
        && data.fetchedAt is string && data.fetchedAt.size() >= 1 && data.fetchedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReport(data, userId) {
      return data.keys().hasAll(['userId', 'periodType', 'dateKey', 'aiInsights', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'periodType', 'dateKey', 'aiInsights', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.periodType in ['daily', 'weekly', 'monthly']
        && data.dateKey is string && data.dateKey.size() >= 1 && data.dateKey.size() <= 32
        && data.aiInsights is string && data.aiInsights.size() <= 15000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Match Blocks ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'budgetAlertThreshold', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'monthlyBudget', 'budgetAlertThreshold', 'updatedAt'])
        );
      allow delete: if false;

      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(taskId)
          && isOwner(userId)
          && isValidTask(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(taskId)
          && isOwner(userId)
          && isValidTask(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['startDate', 'deadline', 'carriedOverFrom', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'priority', 'startDate', 'deadline', 'status', 'notes', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId) && existing().userId == request.auth.uid;
      }

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'date', 'category', 'paymentMethod', 'description', 'note', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId) && existing().userId == request.auth.uid;
      }

      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(noteId)
          && isOwner(userId)
          && isValidNote(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (!('linkedTaskId' in incoming()) || incoming().linkedTaskId == '' || exists(/databases/$(database)/documents/users/$(userId)/tasks/$(incoming().linkedTaskId)));
        allow update: if isValidId(userId) && isValidId(noteId)
          && isOwner(userId)
          && isValidNote(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (!('linkedTaskId' in incoming()) || incoming().linkedTaskId == '' || exists(/databases/$(database)/documents/users/$(userId)/tasks/$(incoming().linkedTaskId)))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'tags', 'pinned', 'linkedTaskId', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && existing().userId == request.auth.uid;
      }

      match /exchangeRates/{dateKey} {
        allow get: if isValidId(userId) && isValidId(dateKey) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(dateKey)
          && isOwner(userId)
          && isValidExchangeRate(incoming(), userId)
          && incoming().date == dateKey
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(dateKey)
          && isOwner(userId)
          && isValidExchangeRate(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['rates', 'previousRates', 'source', 'fetchedAt', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(dateKey) && isOwner(userId) && existing().userId == request.auth.uid;
      }

      match /reports/{reportId} {
        allow get: if isValidId(userId) && isValidId(reportId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(reportId)
          && isOwner(userId)
          && isValidReport(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(reportId)
          && isOwner(userId)
          && isValidReport(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['aiInsights', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(reportId) && isOwner(userId) && existing().userId == request.auth.uid;
      }
    }
  }
}
